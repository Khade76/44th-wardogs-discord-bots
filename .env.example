# Public 44th WARDOGS website status endpoint.
# This should be the PHP endpoint already running on OVH.
DISCORD_STATUS_API_URL=https://YOUR-DOMAIN/api/servers.php
DISCORD_STATUS_REFRESH_MS=30000

# Public 44th WARDOGS website player-stats endpoint used by /stats and /top10.
# No WARCON API key is required by the Discord bots.
DISCORD_STATS_API_URL=https://44thwardogs.com/api/player-stats.php

# Register slash commands immediately in this Discord server while testing.
# Leave blank to register the commands globally instead.
DISCORD_GUILD_ID=

# WARDOGS Server #1 bot
DISCORD_WARDOGS_SERVER_1_BOT_TOKEN=
DISCORD_WARDOGS_SERVER_1_IDENTIFIER=278c7bc5
DISCORD_WARDOGS_SERVER_1_JOIN_CODE=89607037-07ad-4039-8f7d-1fb9a46e707b
# Optional: channel where this bot maintains one auto-updating status embed.
DISCORD_WARDOGS_SERVER_1_STATUS_CHANNEL_ID=

